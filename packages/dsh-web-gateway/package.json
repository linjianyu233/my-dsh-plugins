{
  "name": "@linjianyu/dsh-web-gateway",
  "version": "0.2.0",
  "description": "DSH Web 蓝绿切换网关：常驻代理（http+ws）+ active/staging 双后端 + 探活 + 切流/drain/回滚 + Doctor（监控/诊断/AI 兜底）。零 npm 依赖，纯 node 内置模块。同时是 DSH bundle 插件：宿主层注册包内 skills 到全局层（所有工作区生效）。",
  "type": "module",
  "main": "index.js",
  "bin": {
    "dsh-gateway": "index.js"
  },
  "exports": {
    ".": "./index.js",
    "./plugin": {
      "default": "./lib/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linjianyu233/my-dsh-plugins.git",
    "directory": "packages/dsh-web-gateway"
  },
  "scripts": {
    "test": "node --test tests/unit.test.mjs tests/skill-provider.test.mjs tests/p2.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6"
  },
  "license": "MIT"
}
